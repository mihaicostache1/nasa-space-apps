# The starter runs without environment variables or API keys.
# Add server-side provider configuration here when integrations are implemented.
# Never prefix secrets with NEXT_PUBLIC_.
# Browser-visible FastAPI address, inlined at build time (default http://localhost:8000).
# Docker Compose derives it from API_PORT.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional Docker host port (default 3000):
# WEB_PORT=3100
# Optional FastAPI host port (default 8000):
# API_PORT=8100
# Comma-separated browser origins allowed to call FastAPI; adjust if WEB_PORT changes.
# LUNARWINDOW_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Docker ships a verified demo bundle and enables it by default. Blank disables lookup.
# Native FastAPI: export this variable explicitly to use the committed release.
# Custom Docker paths must exist inside the container (mount custom bundles read-only).
# LUNARWINDOW_PRECOMPUTED_DIR=/app/data/releases/lunarwindow-demo-v1/bundle
# Native: export LUNARWINDOW_PRECOMPUTED_DIR=data/releases/lunarwindow-demo-v1/bundle
# Per-process memory cache caps; non-negative integers, 0 disables caching.
# LUNARWINDOW_CACHE_MAX_ENTRIES=32
# LUNARWINDOW_CACHE_MAX_BYTES=16777216
# Docker API resource limits and Uvicorn concurrency/keep-alive settings.
# LUNARWINDOW_API_MEMORY_LIMIT=1g
# LUNARWINDOW_API_CPUS=2.0
# LUNARWINDOW_API_MAX_CONCURRENCY=16
# LUNARWINDOW_API_KEEP_ALIVE_SECONDS=5
# Linux only: numeric owner of your bind-mounted data directory.
# LOCAL_UID=1000
# LOCAL_GID=1000

# Custom-coordinate evaluation makes live Horizons requests only when explicitly enabled.
# Native setup: pip install -e './backend[dev,gis]' for terrain (gis optional for geometric).
# Docker terrain: use compose.custom.yaml; it mounts DEMs read-only and persists archives.
# LUNARWINDOW_CUSTOM_ENABLED=false
# LUNARWINDOW_CUSTOM_TERRAIN_ENABLED=false
# LUNARWINDOW_CUSTOM_ARCHIVE_DIR=data/processed/custom-ephemeris
# LUNARWINDOW_CUSTOM_DEM_DIR=data/raw/lola
# LUNARWINDOW_CUSTOM_TERRAIN_CACHE_DIR=data/processed/custom-terrain
# LUNARWINDOW_CUSTOM_MAX_CONCURRENCY=1
# LUNARWINDOW_CUSTOM_TIMEOUT_SECONDS=30
# LUNARWINDOW_CUSTOM_MAX_SAMPLES=744
# LUNARWINDOW_CUSTOM_ARCHIVE_MAX_ENTRIES=64
# LUNARWINDOW_CUSTOM_ARCHIVE_MAX_BYTES=67108864
# LUNARWINDOW_CUSTOM_CACHE_MAX_ENTRIES=16
# LUNARWINDOW_CUSTOM_CACHE_MAX_BYTES=16777216
