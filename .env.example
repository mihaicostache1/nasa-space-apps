# The starter runs without environment variables or API keys.
# Add server-side provider configuration here when integrations are implemented.
# Never prefix secrets with NEXT_PUBLIC_.
# Optional Docker host port (default 3000):
# WEB_PORT=3100
# Optional FastAPI host port (default 8000):
# API_PORT=8100
# Comma-separated browser origins allowed to call FastAPI; adjust if WEB_PORT changes.
# LUNARWINDOW_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Linux only: numeric owner of your bind-mounted data directory.
# LOCAL_UID=1000
# LOCAL_GID=1000
